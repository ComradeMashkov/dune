// A tiny reverse-mode automatic differentiation engine (a "micrograd"). Each
// `Value` is a node in a computation graph that remembers how it was produced,
// so gradients can be propagated backward from an output to its inputs.
// `math` supplies the elementary functions whose derivatives are encoded here.
import math;

// An `Edge` links a child result back to one parent operand together with the
// local partial derivative (`weight`) of the result with respect to that parent.
record Edge {
    value: Value,      // the parent Value this edge points to
    weight: real64,    // d(result)/d(parent): the local gradient along this edge

    // Construct an edge from a parent value and its local derivative.
    fn new(value: Value, weight: real64): Edge {
        return Edge { value: value, weight: weight };
    }
}

// A node in the autodiff graph: its numeric value plus the edges to its inputs.
export record Value {
    export data: real64,          // the forward (computed) value
    export grad: real64,          // accumulated gradient after backward()
    export requires_grad: bool,   // whether gradient should flow through this node
    parents: [Edge],              // edges to the operands that produced this value

    // Build a node with zero initial gradient and the given parent edges.
    fn new(data: real64, requires_grad: bool, parents: [Edge]): Value {
        return Value {
            data: data,
            grad: 0.0,
            requires_grad: requires_grad,
            parents: parents,
        };
    }
}

// Build the parent-edge list for a unary result: include the operand only when
// it participates in gradients. `weight` is the local derivative at that operand.
fn parents_for(value: Value, weight: real64): [Edge] {
    parents: [Edge] = [];
    // Constants (requires_grad == false) contribute no edge, pruning the graph.
    if value.requires_grad {
        parents.push(Edge.new(value, weight));
    }

    return parents;
}

// Concatenate two edge lists into one (used to join a binary op's two operands).
fn combine_parents(left: [Edge], right: [Edge]): [Edge] {
    parents: [Edge] = [];
    // Append every edge from the left operand.
    for index = 0; index < left.len(); index = index + 1 {
        parents.push(left[index]);
    }

    // Then every edge from the right operand.
    for index = 0; index < right.len(); index = index + 1 {
        parents.push(right[index]);
    }

    return parents;
}

// An empty parent list, used by leaf nodes (variables and constants).
fn empty_parents(): [Edge] {
    parents: [Edge] = [];
    return parents;
}

// Wrap the result of a unary operation, recording its single parent edge.
// `requires_grad` is inherited from the operand.
fn unary(data: real64, value: Value, weight: real64): Value {
    return Value.new(data, value.requires_grad, parents_for(value, weight));
}

// Wrap the result of a binary operation, recording both parent edges.
fn binary(data: real64, left: Value, left_weight: real64, right: Value, right_weight: real64): Value {
    return Value.new(
        data,
        // The result tracks gradients if either operand does.
        left.requires_grad || right.requires_grad,
        // Merge the (possibly pruned) edges from both operands.
        combine_parents(parents_for(left, left_weight), parents_for(right, right_weight))
    );
}

// Recursively push gradient `amount` into `value` and back through its parents.
// This is the chain rule: each parent receives amount * edge.weight.
fn accumulate(value: Value, amount: real64): unit {
    // Add this node's share of the gradient.
    value.grad = value.grad + amount;

    // Propagate to each parent, scaling by that edge's local derivative.
    for index = 0; index < value.parents.len(); index = index + 1 {
        edge: Edge = value.parents[index];
        accumulate(edge.value, amount * edge.weight);
    }
}

// Recursively reset gradients to zero across the whole upstream graph.
fn zero_grad_visit(value: Value): unit {
    value.grad = 0.0;

    // Visit every parent so no stale gradient remains before a backward pass.
    for index = 0; index < value.parents.len(); index = index + 1 {
        zero_grad_visit(value.parents[index].value);
    }
}

// Create a leaf variable (participates in gradients, no parents).
// example: autograd.variable(3.0).data  // 3
export fn variable(data: real64): Value {
    return Value.new(data, true, empty_parents());
}

// Create a leaf constant (does not participate in gradients).
// example: autograd.constant(5.0).data  // 5
export fn constant(data: real64): Value {
    return Value.new(data, false, empty_parents());
}

// Alias for `variable`: the default way to introduce a differentiable value.
// example: autograd.value(2.0).data  // 2
export fn value(data: real64): Value {
    return variable(data);
}

// Read a node's forward value.
export fn data(value: Value): real64 {
    return value.data;
}

// Read a node's accumulated gradient.
export fn grad(value: Value): real64 {
    return value.grad;
}

// Addition: d/dleft = 1, d/dright = 1.
// example: autograd.variable(2.0).add(autograd.variable(3.0)).data  // 5
export fn add(left: Value, right: Value): Value {
    return binary(left.data + right.data, left, 1.0, right, 1.0);
}

// Addition with a plain scalar on the right (wrapped as a constant).
export fn add(left: Value, right: real64): Value {
    return add(left, constant(right));
}

// Addition with a plain scalar on the left.
export fn add(left: real64, right: Value): Value {
    return add(constant(left), right);
}

// Subtraction: d/dleft = 1, d/dright = -1.
export fn sub(left: Value, right: Value): Value {
    return binary(left.data - right.data, left, 1.0, right, 0.0 - 1.0);
}

// Subtraction with a scalar right operand.
export fn sub(left: Value, right: real64): Value {
    return sub(left, constant(right));
}

// Subtraction with a scalar left operand.
export fn sub(left: real64, right: Value): Value {
    return sub(constant(left), right);
}

// Multiplication: d/dleft = right.data, d/dright = left.data (product rule).
// example: autograd.variable(3.0).mul(autograd.variable(4.0)).data  // 12
export fn mul(left: Value, right: Value): Value {
    return binary(left.data * right.data, left, right.data, right, left.data);
}

// Multiplication with a scalar right operand.
export fn mul(left: Value, right: real64): Value {
    return mul(left, constant(right));
}

// Multiplication with a scalar left operand.
export fn mul(left: real64, right: Value): Value {
    return mul(constant(left), right);
}

// Division: d/dleft = 1/right, d/dright = -left/right^2 (quotient rule).
// example: autograd.variable(10.0).div(autograd.variable(4.0)).data  // 2.5
export fn div(left: Value, right: Value): Value {
    return binary(left.data / right.data, left, 1.0 / right.data, right, (0.0 - left.data) / (right.data * right.data));
}

// Division with a scalar denominator.
export fn div(left: Value, right: real64): Value {
    return div(left, constant(right));
}

// Division with a scalar numerator.
export fn div(left: real64, right: Value): Value {
    return div(constant(left), right);
}

// Negation: d/dvalue = -1.
export fn neg(value: Value): Value {
    return unary(0.0 - value.data, value, 0.0 - 1.0);
}

// Power with a constant exponent: d/dbase = exponent * base^(exponent-1).
// example: autograd.variable(3.0).pow(2.0).data  // 9
export fn pow(base: Value, exponent: real64): Value {
    // Forward value: base^exponent.
    data: real64 = math.pow(base.data, exponent);
    weight: real64 = 0.0;
    // Guard the exponent==0 case so the derivative stays 0 (constant result).
    if exponent != 0.0 {
        weight = exponent * math.pow(base.data, exponent - 1.0);
    }

    return unary(data, base, weight);
}

// ReLU: passes positives through (derivative 1) and clamps negatives to 0.
// example: autograd.variable(0.0 - 5.0).relu().data  // 0
export fn relu(value: Value): Value {
    // Positive input: identity, gradient flows with weight 1.
    if value.data > 0.0 {
        return unary(value.data, value, 1.0);
    }

    // Non-positive input: output 0 and block the gradient (weight 0).
    return unary(0.0, value, 0.0);
}

// Hyperbolic tangent computed from exp, with derivative 1 - tanh^2.
// example: autograd.variable(0.0).tanh().data  // 0
export fn tanh(value: Value): Value {
    // scale = e^(2x); tanh(x) = (scale - 1) / (scale + 1).
    scale: real64 = math.exp(2.0 * value.data);
    data: real64 = (scale - 1.0) / (scale + 1.0);
    return unary(data, value, 1.0 - data * data);
}

// Exponential: d/dvalue = exp(value), which equals the forward result itself.
// example: autograd.variable(0.0).exp().data  // 1
export fn exp(value: Value): Value {
    data: real64 = math.exp(value.data);
    return unary(data, value, data);
}

// Natural log: d/dvalue = 1/value.
// example: autograd.variable(1.0).ln().data  // 0
export fn ln(value: Value): Value {
    return unary(math.ln(value.data), value, 1.0 / value.data);
}

// Square root: d/dvalue = 0.5 / sqrt(value).
// example: autograd.variable(9.0).sqrt().data  // 3
export fn sqrt(value: Value): Value {
    data: real64 = math.sqrt(value.data);
    weight: real64 = 0.0;
    // Avoid dividing by zero when the root is 0.
    if data != 0.0 {
        weight = 0.5 / data;
    }

    return unary(data, value, weight);
}

// Reset gradients throughout the graph feeding into `value`.
export fn zero_grad(value: Value): unit {
    zero_grad_visit(value);
}

// Run a full backward pass: clear old gradients, then seed the output with 1.0
// and propagate. After this, each input's `grad` holds d(value)/d(input).
// example: autograd.variable(3.0).backward()
export fn backward(value: Value): unit {
    zero_grad(value);
    accumulate(value, 1.0);
}
