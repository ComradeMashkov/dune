// Pure-Dune math: named constants plus elementary functions approximated with
// Taylor/Maclaurin series, Newton iteration, and range reduction. Nothing here
// calls native code, so results are identical across backends.

// High-precision real64 constants.
const PI: real64 = 3.141592653589793;      // ratio of circumference to diameter
const TAU: real64 = PI * 2.0;               // one full turn in radians (2*pi)
const E: real64 = 2.718281828459045;        // Euler's number, base of ln/exp
const INVERSE_E: real64 = 1.0 / E;          // 1/e, used as a range-reduction bound
// Lower-precision real32 mirrors of the same constants.
const PI32: real32 = 3.1415927;
const TAU32: real32 = PI32 * 2.0;
const E32: real32 = 2.7182817;
const INVERSE_E32: real32 = 1.0 / E32;

// Square of `value` (generic over any numeric type T).
fn square<T is numeric>(value: T): T {
    return value * value;
}

// Cube of `value`.
fn cube<T is numeric>(value: T): T {
    return value * value * value;
}

// Absolute value: negate when the input is negative.
fn abs<T is numeric>(value: T): T {
    if value < 0 {
        return 0 - value;
    }

    return value;
}

// The smaller of two numbers.
fn min<T is numeric>(left: T, right: T): T {
    if left < right {
        return left;
    }

    return right;
}

// The larger of two numbers.
fn max<T is numeric>(left: T, right: T): T {
    if left > right {
        return left;
    }

    return right;
}

// Constrain `value` to the inclusive range [lower, upper].
fn clamp<T is numeric>(value: T, lower: T, upper: T): T {
    // Below the floor: return the floor.
    if value < lower {
        return lower;
    }

    // Above the ceiling: return the ceiling.
    if value > upper {
        return upper;
    }

    // Already inside the range.
    return value;
}

// Square root via Newton's method (real types only).
fn sqrt<T is real>(value: T): T {
    // sqrt is defined here as 0 for non-positive inputs.
    if value <= 0.0 {
        return 0.0;
    }

    // Start the iteration from `value` itself.
    guess: T = value;
    index = 0;
    // 24 Newton steps: guess <- (guess + value/guess) / 2 converges quadratically.
    while index < 24 {
        guess = (guess + value / guess) / 2.0;
        index = index + 1;
    }

    return guess;
}

// Reduce an angle into (-pi, pi] so the sin/cos series converge quickly.
fn normalize_radians<T is real>(value: T): T {
    // Local copies of pi and 2*pi at the generic precision T.
    pi: T = 3.141592653589793;
    tau: T = pi * 2.0;
    x: T = value;

    // Subtract full turns while the angle is above pi.
    while x > pi {
        x = x - tau;
    }

    // Add full turns while the angle is below -pi.
    while x < 0.0 - pi {
        x = x + tau;
    }

    return x;
}

// Sine via the Maclaurin series after range reduction.
fn sin<T is real>(value: T): T {
    // Bring the angle into (-pi, pi] first.
    x: T = normalize_radians(value);
    // Series bookkeeping: `term` is the current term, `sum` the running total.
    term: T = x;
    sum: T = x;
    n: T = 1.0;

    // Accumulate terms x - x^3/3! + x^5/5! - ... up to n = 11.
    while n < 12.0 {
        // Denominator factors (2n)(2n+1) advance the factorial two steps.
        a: T = 2.0 * n;
        b: T = 2.0 * n + 1.0;
        // Each term multiplies by -x^2 / ((2n)(2n+1)), alternating sign.
        term = (0.0 - term) * x * x / (a * b);
        sum = sum + term;
        n = n + 1.0;
    }

    return sum;
}

// Cosine via the Maclaurin series after range reduction.
fn cos<T is real>(value: T): T {
    // Reduce the angle first.
    x: T = normalize_radians(value);
    // Series starts at 1 (the n = 0 term).
    term: T = 1.0;
    sum: T = 1.0;
    n: T = 1.0;

    // Accumulate 1 - x^2/2! + x^4/4! - ... up to n = 11.
    while n < 12.0 {
        // Denominator factors (2n-1)(2n) advance the even factorial.
        a: T = 2.0 * n - 1.0;
        b: T = 2.0 * n;
        term = (0.0 - term) * x * x / (a * b);
        sum = sum + term;
        n = n + 1.0;
    }

    return sum;
}

// Tangent as sine over cosine.
fn tan<T is real>(value: T): T {
    return sin(value) / cos(value);
}

// Exponential e^value using range reduction plus the Taylor series.
fn exp<T is real>(value: T): T {
    // e at precision T, and a running `scale` counting whole-unit shifts.
    e: T = 2.718281828459045;
    x: T = value;
    scale = 0;
    negative_one: T = 0.0 - 1.0;

    // Pull `x` down into [-1, 1] by counting off whole units (multiplied back later).
    while x > 1.0 {
        x = x - 1.0;
        scale = scale + 1;
    }

    // Push `x` up into [-1, 1] from below.
    while x < negative_one {
        x = x + 1.0;
        scale = scale - 1;
    }

    // Taylor series for e^x on the reduced x: sum of x^n / n!.
    term: T = 1.0;
    sum: T = 1.0;
    n: T = 1.0;
    while n < 28.0 {
        term = term * x / n;
        sum = sum + term;
        n = n + 1.0;
    }

    // Reapply the removed whole units by multiplying by e per positive step.
    while scale > 0 {
        sum = sum * e;
        scale = scale - 1;
    }

    // ...and dividing by e per negative step.
    while scale < 0 {
        sum = sum / e;
        scale = scale + 1;
    }

    return sum;
}

// Natural logarithm via range reduction and the artanh series.
fn ln<T is real>(value: T): T {
    // ln is undefined for non-positive inputs; return 0 as a safe fallback.
    if value <= 0.0 {
        return 0.0;
    }

    // Constants e and 1/e used to fold `x` toward 1.
    e: T = 2.718281828459045;
    inverse_e: T = 1.0 / e;
    x: T = value;
    // `scale_value` counts how many factors of e were divided/multiplied out.
    scale_value: T = 0.0;

    // Divide out factors of e while x is large (each adds 1 to the log).
    while x > e {
        x = x / e;
        scale_value = scale_value + 1.0;
    }

    // Multiply in factors of e while x is small (each subtracts 1).
    while x < inverse_e {
        x = x * e;
        scale_value = scale_value - 1.0;
    }

    // Use ln(x) = 2 * artanh(y) where y = (x-1)/(x+1); y2 is y squared.
    y: T = (x - 1.0) / (x + 1.0);
    y2: T = y * y;
    term: T = y;
    sum: T = 0.0;
    n: T = 1.0;

    // Sum the odd-power artanh series y/1 + y^3/3 + y^5/5 + ...
    while n < 39.0 {
        sum = sum + term / n;
        term = term * y2;
        n = n + 2.0;
    }

    // Combine the series with the removed scale factor.
    return 2.0 * sum + scale_value;
}

// Integer power: base raised to an integer exponent by repeated multiplication.
fn pow<T is real>(base: T, exponent: int): T {
    result: T = 1.0;
    // Work with the magnitude of the exponent.
    count = exponent;
    if count < 0 {
        count = 0 - count;
    }

    // Multiply `base` into the result `count` times.
    while count > 0 {
        result = result * base;
        count = count - 1;
    }

    // A negative exponent means take the reciprocal.
    if exponent < 0 {
        return 1.0 / result;
    }

    return result;
}

// Real power: base^exponent for a real exponent via exp(exponent * ln(base)).
// This overload is chosen when the exponent has the same real type as the base.
fn pow<T is real>(base: T, exponent: T): T {
    return exp(exponent * ln(base));
}

// Largest whole number not greater than `value`.
fn floor<T is real>(value: T): T {
    result: T = 0.0;
    // For non-negatives, step up by 1 while the next step stays within value.
    if value >= 0.0 {
        while result + 1.0 <= value {
            result = result + 1.0;
        }
        return result;
    }

    // For negatives, step down by 1 until at or below value.
    while result > value {
        result = result - 1.0;
    }
    return result;
}

// Smallest whole number not less than `value`.
fn ceil<T is real>(value: T): T {
    // Start from the floor; bump up by one when the value was not already whole.
    result: T = floor(value);
    if result < value {
        return result + 1.0;
    }

    return result;
}

// Round to the nearest whole number (halves round away from zero).
fn round<T is real>(value: T): T {
    // For non-negatives, floor(value + 0.5) rounds half up.
    if value >= 0.0 {
        return floor(value + 0.5);
    }

    // For negatives, ceil(value - 0.5) rounds half away from zero.
    return ceil(value - 0.5);
}
