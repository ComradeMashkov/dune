// Bring in the Outcome result type so file operations can report errors.
import outcome;

// Minimal file-system access built on the `__read_file` / `__write_file` VM
// intrinsics (dedicated opcodes, not C/C++ foreign functions). This module is
// pure Dune: it only shapes the primitive `(ok, payload)` results into the
// `Outcome` type so errors stay explicit and compose with `?`.

// Read the whole file at `path` as text.
// On success returns `Done(contents)`, otherwise `Failed(message)`.
// example: fs.read_text("dune_example_tmp.txt")
export fn read_text(path: text): outcome.Outcome<text, text> {
    // The intrinsic returns a tuple: a success flag and a payload string.
    (ok, payload) = __read_file(path);
    // When the read succeeded, the payload is the file contents.
    if ok {
        return outcome.done(payload, "");
    }

    // Otherwise the payload is the error message; report it as a failure.
    return outcome.failed("", payload);
}

// Write `content` to `path`, replacing any existing file.
// On success returns `Done(path)`, otherwise `Failed(message)`.
// example: fs.write_text("dune_example_tmp.txt", "hello")
export fn write_text(path: text, content: text): outcome.Outcome<text, text> {
    // The intrinsic returns a success flag and (on failure) an error string.
    (ok, error) = __write_file(path, content);
    // On success, echo back the path that was written.
    if ok {
        return outcome.done(path, "");
    }

    // Otherwise surface the error message as a failure.
    return outcome.failed("", error);
}
