// Deterministic chart rendering in pure Dune.
//
// The module keeps chart specification separate from output backends:
// Chart -> SVG/HTML renderer -> file or display backend. The first display
// backend is intentionally headless-friendly: `show` returns an Outcome instead
// of trying to open a GUI process. Future native/browser/notebook backends can
// plug in behind the same API.
import fs;
import fmt;
import math;
import outcome;
import process;
import runtime;
import stats;

const DEFAULT_WIDTH: int = 640;
const DEFAULT_HEIGHT: int = 400;
const PLOT_LEFT: real64 = 64.0;
const PLOT_RIGHT: real64 = 36.0;
const PLOT_TOP: real64 = 48.0;
const PLOT_BOTTOM: real64 = 64.0;

record Series {
    kind: text,
    xs: [real64],
    ys: [real64],
    label_text: text,
    color: text,

    static fn new(kind: text, xs: [real64], ys: [real64], label_text: text, color: text): Series {
        require_xy(xs, ys);
        return Series { kind: kind, xs: xs, ys: ys, label_text: label_text, color: color };
    }

    fn label(value: text): Series {
        return Series { kind: this.kind, xs: this.xs, ys: this.ys, label_text: value, color: this.color };
    }
}

export record Chart {
    series: [Series],
    title_text: text,
    x_label_text: text,
    y_label_text: text,
    legend_enabled: bool,
    width: int,
    height: int,
    // Number of major grid cells per axis (0 = no grid).
    grid_cells: int = 0,
    // Minor subdivisions drawn inside each major cell (0 = no minor grid).
    minor_cells: int = 0,

    export static fn empty(): Chart {
        empty_series: [Series] = [];
        return Chart {
            series: empty_series,
            title_text: "",
            x_label_text: "",
            y_label_text: "",
            legend_enabled: false,
            width: DEFAULT_WIDTH,
            height: DEFAULT_HEIGHT,
            grid_cells: 0,
            minor_cells: 0,
        };
    }

    // Return a copy of the chart with its title set.
    // example: plot.svg(plot.line([1.0, 2.0]).title("Sales")).contains("Sales")  // 1
    export fn title(value: text): Chart {
        return Chart {
            series: this.series,
            title_text: value,
            x_label_text: this.x_label_text,
            y_label_text: this.y_label_text,
            legend_enabled: this.legend_enabled,
            width: this.width,
            height: this.height,
            grid_cells: this.grid_cells,
            minor_cells: this.minor_cells,
        };
    }

    // Return a copy with the x-axis label set.
    // example: plot.line([1.0, 2.0]).x_label("time")
    export fn x_label(value: text): Chart {
        return Chart {
            series: this.series,
            title_text: this.title_text,
            x_label_text: value,
            y_label_text: this.y_label_text,
            legend_enabled: this.legend_enabled,
            width: this.width,
            height: this.height,
            grid_cells: this.grid_cells,
            minor_cells: this.minor_cells,
        };
    }

    // Return a copy with the y-axis label set.
    // example: plot.line([1.0, 2.0]).y_label("value")
    export fn y_label(value: text): Chart {
        return Chart {
            series: this.series,
            title_text: this.title_text,
            x_label_text: this.x_label_text,
            y_label_text: value,
            legend_enabled: this.legend_enabled,
            width: this.width,
            height: this.height,
            grid_cells: this.grid_cells,
            minor_cells: this.minor_cells,
        };
    }

    // Return a copy with the legend shown or hidden.
    // example: plot.line([1.0, 2.0]).label("trend").legend(true)
    export fn legend(enabled: bool): Chart {
        return Chart {
            series: this.series,
            title_text: this.title_text,
            x_label_text: this.x_label_text,
            y_label_text: this.y_label_text,
            legend_enabled: enabled,
            width: this.width,
            height: this.height,
            grid_cells: this.grid_cells,
            minor_cells: this.minor_cells,
        };
    }

    // Return a copy sized to `width` x `height` pixels (both must be positive).
    // example: plot.svg(plot.line([1.0, 2.0]).size(640, 480)).contains("width=\"640\"")  // 1
    export fn size(width: int, height: int): Chart {
        if width <= 0 || height <= 0 {
            runtime.panic("plot: chart size must be positive");
        }

        return Chart {
            series: this.series,
            title_text: this.title_text,
            x_label_text: this.x_label_text,
            y_label_text: this.y_label_text,
            legend_enabled: this.legend_enabled,
            width: width,
            height: height,
            grid_cells: this.grid_cells,
            minor_cells: this.minor_cells,
        };
    }

    // Return a copy with a background grid of `cells` major divisions per axis
    // (0 disables it).
    // example: plot.svg(plot.line([1.0, 2.0]).grid(5)).contains("plot-grid")  // 1
    export fn grid(cells: int): Chart {
        return Chart {
            series: this.series,
            title_text: this.title_text,
            x_label_text: this.x_label_text,
            y_label_text: this.y_label_text,
            legend_enabled: this.legend_enabled,
            width: this.width,
            height: this.height,
            grid_cells: cells,
            minor_cells: this.minor_cells,
        };
    }

    // Return a copy that also draws `subdivisions` minor grid lines inside each
    // major cell. Pair it with `grid` to set the major divisions.
    // example: plot.svg(plot.line([1.0, 2.0]).grid(4).minor_grid(5)).contains("plot-grid-minor")  // 1
    export fn minor_grid(subdivisions: int): Chart {
        return Chart {
            series: this.series,
            title_text: this.title_text,
            x_label_text: this.x_label_text,
            y_label_text: this.y_label_text,
            legend_enabled: this.legend_enabled,
            width: this.width,
            height: this.height,
            grid_cells: this.grid_cells,
            minor_cells: subdivisions,
        };
    }

    export fn label(value: text): Chart {
        if this.series.len() == 0 {
            runtime.panic("plot: cannot label an empty chart");
        }

        return Chart {
            series: set_last_label(this.series, value),
            title_text: this.title_text,
            x_label_text: this.x_label_text,
            y_label_text: this.y_label_text,
            legend_enabled: this.legend_enabled,
            width: this.width,
            height: this.height,
            grid_cells: this.grid_cells,
            minor_cells: this.minor_cells,
        };
    }

    export fn add_line(xs: [real64], ys: [real64]): Chart {
        return append_series(this, Series.new("line", xs, ys, "", palette(this.series.len())));
    }

    export fn add_line(ys: [real64]): Chart {
        return this.add_line(default_xs(ys), ys);
    }

    export fn add_scatter(xs: [real64], ys: [real64]): Chart {
        return append_series(this, Series.new("scatter", xs, ys, "", palette(this.series.len())));
    }

    export fn add_scatter(ys: [real64]): Chart {
        return this.add_scatter(default_xs(ys), ys);
    }

    export fn add_bar(xs: [real64], ys: [real64]): Chart {
        return append_series(this, Series.new("bar", xs, ys, "", palette(this.series.len())));
    }

    export fn add_bar(ys: [real64]): Chart {
        return this.add_bar(default_xs(ys), ys);
    }

    export fn add_area(xs: [real64], ys: [real64]): Chart {
        return append_series(this, Series.new("area", xs, ys, "", palette(this.series.len())));
    }

    export fn add_area(ys: [real64]): Chart {
        return this.add_area(default_xs(ys), ys);
    }

    export fn add_step(xs: [real64], ys: [real64]): Chart {
        return append_series(this, Series.new("step", xs, ys, "", palette(this.series.len())));
    }

    export fn add_step(ys: [real64]): Chart {
        return this.add_step(default_xs(ys), ys);
    }
}

export fn empty(): Chart {
    return Chart.empty();
}

// A line chart from paired x/y data.
// example: plot.svg(plot.line([0.0, 1.0, 2.0], [3.0, 7.0, 5.0])).contains("<svg")  // 1
export fn line(xs: [real64], ys: [real64]): Chart {
    return Chart.empty().add_line(xs, ys);
}

// A line chart from y values, with x taken as the index 0, 1, 2, ...
// example: plot.svg(plot.line([1.0, 3.0, 2.0])).contains("<svg")  // 1
export fn line(ys: [real64]): Chart {
    return Chart.empty().add_line(ys);
}

// A scatter chart from paired x/y data.
// example: plot.svg(plot.scatter([1.0, 2.0], [3.0, 4.0])).contains("<circle")  // 1
export fn scatter(xs: [real64], ys: [real64]): Chart {
    return Chart.empty().add_scatter(xs, ys);
}

// A scatter chart from y values against their index.
// example: plot.scatter([3.0, 1.0, 4.0])
export fn scatter(ys: [real64]): Chart {
    return Chart.empty().add_scatter(ys);
}

// A bar chart from paired x/y data.
// example: plot.svg(plot.bar([1.0, 2.0], [3.0, 5.0])).contains("<rect")  // 1
export fn bar(xs: [real64], ys: [real64]): Chart {
    return Chart.empty().add_bar(xs, ys);
}

// A bar chart from y values against their index.
// example: plot.svg(plot.bar([3.0, 1.0, 2.0])).contains("<rect")  // 1
export fn bar(ys: [real64]): Chart {
    return Chart.empty().add_bar(ys);
}

// An area chart: a line filled down to the baseline.
// example: plot.svg(plot.area([0.0, 1.0, 2.0], [3.0, 7.0, 5.0])).contains("<polygon")  // 1
export fn area(xs: [real64], ys: [real64]): Chart {
    return Chart.empty().add_area(xs, ys);
}

// An area chart from y values against their index.
// example: plot.svg(plot.area([3.0, 1.0, 2.0])).contains("<polygon")  // 1
export fn area(ys: [real64]): Chart {
    return Chart.empty().add_area(ys);
}

// A step chart: values held constant between samples (like a staircase).
// example: plot.svg(plot.step([0.0, 1.0, 2.0], [3.0, 7.0, 5.0])).contains("<polyline")  // 1
export fn step(xs: [real64], ys: [real64]): Chart {
    return Chart.empty().add_step(xs, ys);
}

// A step chart from y values against their index.
// example: plot.svg(plot.step([3.0, 1.0, 2.0])).contains("<polyline")  // 1
export fn step(ys: [real64]): Chart {
    return Chart.empty().add_step(ys);
}

// A pie chart. Each value becomes a wedge sized by its share of the total and
// coloured from the palette; wedges are labelled with their percentage.
// example: plot.svg(plot.pie([3.0, 5.0, 2.0])).contains("<path")  // 1
export fn pie(values: [real64]): Chart {
    labels: [text] = [];
    for index = 0; index < values.len(); index = index + 1 {
        labels.push("");
    }

    return pie(values, labels);
}

// A pie chart with a category name for each wedge (shown in the legend).
// example: plot.svg(plot.pie([3.0, 5.0], ["a", "b"]).legend(true)).contains("<path")  // 1
export fn pie(values: [real64], labels: [text]): Chart {
    if values.len() == 0 {
        runtime.panic("plot: pie requires at least one value");
    }
    if labels.len() != values.len() {
        runtime.panic("plot: pie labels and values length mismatch");
    }

    // One "pie" series per wedge keeps the value, its colour, and its legend
    // label together, and lets the existing legend renderer work unchanged.
    chart = Chart.empty();
    for index = 0; index < values.len(); index = index + 1 {
        if values[index] < 0.0 {
            runtime.panic("plot: pie values must be non-negative");
        }
        wedge = Series.new("pie", [0.0], [values[index]], labels[index], palette(index));
        chart = append_series(chart, wedge);
    }

    return chart;
}

// A histogram: bucket `values` into `bins` equal-width bars.
// example: plot.svg(plot.histogram([1.0, 2.0, 2.0, 3.0], 3)).contains("<svg")  // 1
export fn histogram(values: [real64], bins: int): Chart {
    if values.len() == 0 {
        runtime.panic("plot: histogram requires at least one value");
    }
    if bins <= 0 {
        runtime.panic("plot: histogram bin count must be positive");
    }

    lo = values[0];
    hi = values[0];
    for index = 1; index < values.len(); index = index + 1 {
        if values[index] < lo {
            lo = values[index];
        }
        if values[index] > hi {
            hi = values[index];
        }
    }

    span = hi - lo;
    if span == 0.0 {
        span = 1.0;
    }

    counts: [real64] = [];
    for index = 0; index < bins; index = index + 1 {
        counts.push(0.0);
    }

    width = span / (bins to real64);
    for index = 0; index < values.len(); index = index + 1 {
        slot = math.floor((values[index] - lo) / width) to int;
        if slot < 0 {
            slot = 0;
        }
        if slot >= bins {
            slot = bins - 1;
        }
        counts[slot] = counts[slot] + 1.0;
    }

    xs: [real64] = [];
    for index = 0; index < bins; index = index + 1 {
        xs.push(lo + ((index to real64) + 0.5) * width);
    }

    return bar(xs, counts);
}

// Build a bar chart from a validated stats.Histogram. This preserves custom
// bin edges and lets data workflows compute/count once in `stats`, then render
// the same result in scripts and notebooks.
// example: plot.svg(plot.histogram(stats.histogram([1.0, 2.0, 3.0], 2).value_or(stats.empty_histogram()))).contains("<svg")  // 1
export fn histogram(data: stats.Histogram): Chart {
    if data.len() == 0 {
        runtime.panic("plot: histogram result must contain at least one bin");
    }
    return bar(data.bin_centers(), data.counts_as_real64());
}

// Select the display backend for `show`. Supported MVP backends are:
// - "none": return a clear unsupported/headless error;
// - "svg": return the deterministic SVG text;
// - "html": return a deterministic HTML wrapper containing the SVG.
// - "native": open a platform-native plot window when the VM supports it.
export fn use_backend(name: text): unit {
    __plot_backend_set(name);
}

// The active backend used by `show`. Reads `DUNE_PLOT_BACKEND` if set,
// otherwise the value last passed to `use_backend`.
// example: plot.use_backend("svg"); plot.backend()  // "svg"
export fn backend(): text {
    return process.env_or("DUNE_PLOT_BACKEND", __plot_backend_get());
}

// The backend names `show` understands.
// example: plot.available_backends().len()  // 4
export fn available_backends(): [text] {
    return ["none", "svg", "html", "native"];
}

// Render `chart` to deterministic standalone SVG text.
// example: plot.svg(plot.line([1.0, 2.0])).starts_with("<svg")  // 1
export fn svg(chart: Chart): text {
    return render_svg(chart);
}

// Arrange several charts into one SVG as a grid of `cols` columns (rows are
// filled left-to-right, top-to-bottom). Each chart keeps its own size and is
// scaled into an equal cell taken from the first chart's dimensions.
// example: plot.subplots([plot.line([1.0, 2.0]), plot.bar([3.0, 1.0])], 2).contains("<svg")  // 1
export fn subplots(charts: [Chart], cols: int): text {
    return render_subplots(charts, cols);
}

// Render `chart` to a deterministic standalone HTML document wrapping the SVG.
// example: plot.html(plot.line([1.0, 2.0])).contains("<!doctype")  // 1
export fn html(chart: Chart): text {
    title = chart.title_text;
    if title == "" {
        title = "Dune plot";
    }

    return fmt.format("<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>{}</title>\n</head>\n<body>\n{}\n</body>\n</html>\n",
                  escape_xml(title), svg(chart));
}

// Write `chart` as SVG to `path`, returning an `Outcome` for the write.
// example: plot.save_svg(plot.line([1.0, 2.0]), "chart.svg").is_done()  // 1
export fn save_svg(chart: Chart, path: text): outcome.Outcome<text, text> {
    return fs.write_text(path, svg(chart));
}

// Write `chart` as an HTML document to `path`, returning an `Outcome`.
// example: plot.save_html(plot.line([1.0, 2.0]), "chart.html").is_done()  // 1
export fn save_html(chart: Chart, path: text): outcome.Outcome<text, text> {
    return fs.write_text(path, html(chart));
}

// Open `chart` in a native plot window where the VM supports it; returns an
// `Outcome` describing whether the window opened (a headless-safe error if not).
export fn show_native(chart: Chart): outcome.Outcome<text, text> {
    (ok, message) = __plot_show_native(svg(chart));
    if ok {
        return outcome.done_text(message);
    }

    return outcome.failed_text(message);
}

// Wrap a grid of charts in a standalone HTML document.
// example: plot.subplots_html([plot.line([1.0, 2.0])], 1).contains("<!doctype")  // 1
export fn subplots_html(charts: [Chart], cols: int): text {
    return fmt.format("<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Dune subplots</title>\n</head>\n<body>\n{}\n</body>\n</html>\n",
                  render_subplots(charts, cols));
}

// Write a grid of charts as SVG to `path`.
// example: plot.save_subplots_svg([plot.line([1.0, 2.0]), plot.bar([2.0, 1.0])], 2, "grid.svg").is_done()  // 1
export fn save_subplots_svg(charts: [Chart], cols: int, path: text): outcome.Outcome<text, text> {
    return fs.write_text(path, render_subplots(charts, cols));
}

// Write a grid of charts as an HTML document to `path`.
// example: plot.save_subplots_html([plot.line([1.0, 2.0])], 1, "grid.html").is_done()  // 1
export fn save_subplots_html(charts: [Chart], cols: int, path: text): outcome.Outcome<text, text> {
    return fs.write_text(path, subplots_html(charts, cols));
}

// Open a grid of charts in the native plot window where the VM supports it. The
// window renders the composed SVG, so subplots display exactly as they save.
export fn show_subplots_native(charts: [Chart], cols: int): outcome.Outcome<text, text> {
    (ok, message) = __plot_show_native(render_subplots(charts, cols));
    if ok {
        return outcome.done_text(message);
    }

    return outcome.failed_text(message);
}

export fn show(chart: Chart): outcome.Outcome<text, text> {
    selected = backend();
    if selected == "svg" {
        return outcome.done_text(svg(chart));
    }
    if selected == "html" {
        return outcome.done_text(html(chart));
    }
    if selected == "none" {
        return outcome.failed_text("plot.show has no display backend; use plot.save_svg/save_html or plot.use_backend(\"svg\") in headless runs");
    }
    if selected == "native" {
        return show_native(chart);
    }
    if selected == "macosx" {
        return show_native(chart);
    }

    return outcome.failed_text(fmt.format("plot.show backend '{}' is not available", selected));
}

fn append_series(chart: Chart, series: Series): Chart {
    next: [Series] = [];
    for index = 0; index < chart.series.len(); index = index + 1 {
        next.push(chart.series[index]);
    }
    next.push(series);

    return Chart {
        series: next,
        title_text: chart.title_text,
        x_label_text: chart.x_label_text,
        y_label_text: chart.y_label_text,
        legend_enabled: chart.legend_enabled,
        width: chart.width,
        height: chart.height,
        grid_cells: chart.grid_cells,
        minor_cells: chart.minor_cells,
    };
}

fn set_last_label(series: [Series], label: text): [Series] {
    result: [Series] = [];
    last = series.len() - 1;
    for index = 0; index < series.len(); index = index + 1 {
        if index == last {
            result.push(series[index].label(label));
        } else {
            result.push(series[index]);
        }
    }

    return result;
}

fn require_xy(xs: [real64], ys: [real64]): unit {
    if xs.len() != ys.len() {
        runtime.panic("plot: xs and ys length mismatch");
    }
    if xs.len() == 0 {
        runtime.panic("plot: data series cannot be empty");
    }
}

fn default_xs(ys: [real64]): [real64] {
    xs: [real64] = [];
    for index = 0; index < ys.len(); index = index + 1 {
        xs.push((index + 1) to real64);
    }

    return xs;
}

fn palette(index: int): text {
    slot = index % 8;
    if slot == 0 {
        return "#2563eb";
    }
    if slot == 1 {
        return "#dc2626";
    }
    if slot == 2 {
        return "#16a34a";
    }
    if slot == 3 {
        return "#9333ea";
    }
    if slot == 4 {
        return "#ea580c";
    }
    if slot == 5 {
        return "#0891b2";
    }
    if slot == 6 {
        return "#4f46e5";
    }
    return "#be123c";
}

fn escape_xml(value: text): text {
    escaped = "";
    for index = 0; index < value.len(); index = index + 1 {
        ch = value[index];
        if ch == '&' {
            escaped = fmt.format("{}&amp;", escaped);
        } else {
            if ch == '<' {
                escaped = fmt.format("{}&lt;", escaped);
            } else {
                if ch == '>' {
                    escaped = fmt.format("{}&gt;", escaped);
                } else {
                    if ch == '"' {
                        escaped = fmt.format("{}&quot;", escaped);
                    } else {
                        if ch == '\'' {
                            escaped = fmt.format("{}&apos;", escaped);
                        } else {
                            escaped = fmt.format("{}{}", escaped, ch);
                        }
                    }
                }
            }
        }
    }

    return escaped;
}

fn x_min(chart: Chart): real64 {
    require_chart_data(chart);
    result = chart.series[0].xs[0];
    for s = 0; s < chart.series.len(); s = s + 1 {
        series = chart.series[s];
        for index = 0; index < series.xs.len(); index = index + 1 {
            if series.xs[index] < result {
                result = series.xs[index];
            }
        }
    }

    return result - bar_x_pad(chart);
}

fn x_max(chart: Chart): real64 {
    require_chart_data(chart);
    result = chart.series[0].xs[0];
    for s = 0; s < chart.series.len(); s = s + 1 {
        series = chart.series[s];
        for index = 0; index < series.xs.len(); index = index + 1 {
            if series.xs[index] > result {
                result = series.xs[index];
            }
        }
    }

    return result + bar_x_pad(chart);
}

// Bars are centred on their x value, so the outermost bars would spill past the
// axes. Pad the x-domain by half a slot on each side when the chart has bars.
fn bar_x_pad(chart: Chart): real64 {
    if count_bar_series(chart) == 0 {
        return 0.0;
    }

    points = 0;
    for index = 0; index < chart.series.len(); index = index + 1 {
        if chart.series[index].xs.len() > points {
            points = chart.series[index].xs.len();
        }
    }
    if points <= 1 {
        return 0.5;
    }

    lo = chart.series[0].xs[0];
    hi = lo;
    for s = 0; s < chart.series.len(); s = s + 1 {
        series = chart.series[s];
        for index = 0; index < series.xs.len(); index = index + 1 {
            if series.xs[index] < lo {
                lo = series.xs[index];
            }
            if series.xs[index] > hi {
                hi = series.xs[index];
            }
        }
    }

    return (hi - lo) / ((points - 1) to real64) / 2.0;
}

fn y_min(chart: Chart): real64 {
    require_chart_data(chart);
    result = chart.series[0].ys[0];
    for s = 0; s < chart.series.len(); s = s + 1 {
        series = chart.series[s];
        for index = 0; index < series.ys.len(); index = index + 1 {
            if series.ys[index] < result {
                result = series.ys[index];
            }
        }
    }
    if result > 0.0 {
        return 0.0;
    }

    return result;
}

fn y_max(chart: Chart): real64 {
    require_chart_data(chart);
    result = chart.series[0].ys[0];
    for s = 0; s < chart.series.len(); s = s + 1 {
        series = chart.series[s];
        for index = 0; index < series.ys.len(); index = index + 1 {
            if series.ys[index] > result {
                result = series.ys[index];
            }
        }
    }
    if result < 0.0 {
        return 0.0;
    }

    return result;
}

fn require_chart_data(chart: Chart): unit {
    if chart.series.len() == 0 {
        runtime.panic("plot: chart has no series");
    }
}

fn normalize_span(minimum: real64, maximum: real64): real64 {
    span = maximum - minimum;
    if span == 0.0 {
        return 1.0;
    }

    return span;
}

fn plot_width(chart: Chart): real64 {
    return (chart.width to real64) - PLOT_LEFT - PLOT_RIGHT;
}

fn plot_height(chart: Chart): real64 {
    return (chart.height to real64) - PLOT_TOP - PLOT_BOTTOM;
}

fn scale_x(chart: Chart, value: real64, minimum: real64, maximum: real64): real64 {
    span = normalize_span(minimum, maximum);
    if maximum == minimum {
        return math.round(PLOT_LEFT + plot_width(chart) / 2.0);
    }

    return math.round(PLOT_LEFT + ((value - minimum) / span) * plot_width(chart));
}

fn scale_y(chart: Chart, value: real64, minimum: real64, maximum: real64): real64 {
    span = normalize_span(minimum, maximum);
    if maximum == minimum {
        return math.round(PLOT_TOP + plot_height(chart) / 2.0);
    }

    return math.round(PLOT_TOP + ((maximum - value) / span) * plot_height(chart));
}

// Everything inside the <svg> element (title, background, grid, axes, series,
// labels, legend) but not the <svg> wrapper itself, so it can be reused both as
// a standalone chart and as a nested viewport inside `subplots`.
fn render_svg_body(chart: Chart): text {
    require_chart_data(chart);

    // Pie charts have no axes and are laid out radially, so they take a
    // dedicated body renderer.
    if chart.series.len() > 0 && chart.series[0].kind == "pie" {
        return render_pie_body(chart);
    }

    xmin = x_min(chart);
    xmax = x_max(chart);
    ymin = y_min(chart);
    ymax = y_max(chart);

    output = fmt.format("<title>{}</title>\n", escape_xml(chart.title_text));
    output = fmt.format("{}<rect width=\"{}\" height=\"{}\" fill=\"#ffffff\"/>\n", output, chart.width, chart.height);
    if chart.grid_cells > 0 {
        output = fmt.format("{}{}\n", output, render_grid(chart));
    }
    output = fmt.format("{}{}\n", output, render_axes(chart, xmin, xmax, ymin, ymax));

    for index = 0; index < chart.series.len(); index = index + 1 {
        output = fmt.format("{}{}\n", output, render_series(chart, chart.series[index], index, xmin, xmax, ymin, ymax));
    }

    output = fmt.format("{}{}", output, render_labels(chart, xmin, xmax, ymin, ymax));
    if chart.legend_enabled {
        output = fmt.format("{}{}", output, render_legend(chart));
    }

    return output;
}

fn render_svg(chart: Chart): text {
    header = fmt.format("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{}\" height=\"{}\" viewBox=\"0 0 {} {}\">\n",
                    chart.width, chart.height, chart.width, chart.height);
    return fmt.format("{}{}</svg>\n", header, render_svg_body(chart));
}

fn render_subplots(charts: [Chart], cols: int): text {
    if charts.len() == 0 {
        runtime.panic("plot: subplots needs at least one chart");
    }
    if cols <= 0 {
        runtime.panic("plot: subplots columns must be positive");
    }

    rows = (charts.len() + cols - 1) / cols;
    cell_w = charts[0].width;
    cell_h = charts[0].height;
    total_w = cell_w * cols;
    total_h = cell_h * rows;

    output = fmt.format("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{}\" height=\"{}\" viewBox=\"0 0 {} {}\">\n",
                    total_w, total_h, total_w, total_h);
    output = fmt.format("{}<rect width=\"{}\" height=\"{}\" fill=\"#ffffff\"/>\n", output, total_w, total_h);

    for index = 0; index < charts.len(); index = index + 1 {
        col = index % cols;
        row = index / cols;
        cx = col * cell_w;
        cy = row * cell_h;
        chart = charts[index];
        // Nested <svg> viewports position and scale each chart into its cell.
        output = fmt.format("{}<svg x=\"{}\" y=\"{}\" width=\"{}\" height=\"{}\" viewBox=\"0 0 {} {}\">\n",
                        output, cx, cy, cell_w, cell_h, chart.width, chart.height);
        output = fmt.format("{}{}</svg>\n", output, render_svg_body(chart));
    }

    return fmt.format("{}</svg>\n", output);
}

fn render_grid(chart: Chart): text {
    left = PLOT_LEFT;
    right = (chart.width to real64) - PLOT_RIGHT;
    top = PLOT_TOP;
    bottom = (chart.height to real64) - PLOT_BOTTOM;

    output = "";

    // Minor grid first, so the darker major lines draw on top of it.
    if chart.minor_cells > 1 {
        total_minor = chart.grid_cells * chart.minor_cells;
        output = fmt.format("{}<g class=\"plot-grid-minor\" fill=\"none\" stroke=\"#eef2f7\" stroke-width=\"1\">\n", output);
        for index = 1; index < total_minor; index = index + 1 {
            f = (index to real64) / (total_minor to real64);
            gx = left + (right - left) * f;
            gy = top + (bottom - top) * f;
            output = fmt.format("{}<line x1=\"{}\" y1=\"{}\" x2=\"{}\" y2=\"{}\"/>\n", output, gx, top, gx, bottom);
            output = fmt.format("{}<line x1=\"{}\" y1=\"{}\" x2=\"{}\" y2=\"{}\"/>\n", output, left, gy, right, gy);
        }
        output = fmt.format("{}</g>\n", output);
    }

    // Major grid.
    output = fmt.format("{}<g class=\"plot-grid\" fill=\"none\" stroke=\"#d7dee7\" stroke-width=\"1\">\n", output);
    for index = 0; index <= chart.grid_cells; index = index + 1 {
        f = (index to real64) / (chart.grid_cells to real64);
        gx = left + (right - left) * f;
        gy = top + (bottom - top) * f;
        output = fmt.format("{}<line x1=\"{}\" y1=\"{}\" x2=\"{}\" y2=\"{}\"/>\n", output, gx, top, gx, bottom);
        output = fmt.format("{}<line x1=\"{}\" y1=\"{}\" x2=\"{}\" y2=\"{}\"/>\n", output, left, gy, right, gy);
    }

    return fmt.format("{}</g>", output);
}

fn render_axes(chart: Chart, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    left = PLOT_LEFT;
    right = (chart.width to real64) - PLOT_RIGHT;
    top = PLOT_TOP;
    bottom = (chart.height to real64) - PLOT_BOTTOM;

    output = fmt.format("<g class=\"axes\" fill=\"none\" stroke=\"#334155\" stroke-width=\"1\">\n");
    output = fmt.format("{}<line x1=\"{}\" y1=\"{}\" x2=\"{}\" y2=\"{}\"/>\n", output, left, bottom, right, bottom);
    output = fmt.format("{}<line x1=\"{}\" y1=\"{}\" x2=\"{}\" y2=\"{}\"/>\n", output, left, top, left, bottom);
    output = fmt.format("{}</g>\n", output);

    output = fmt.format("{}<g class=\"ticks\" fill=\"#475569\" font-family=\"sans-serif\" font-size=\"11\">\n", output);
    output = fmt.format("{}<text x=\"{}\" y=\"{}\" text-anchor=\"middle\">{}</text>\n",
                    output, left, bottom + 18.0, escape_xml(fmt.format("{}", xmin)));
    output = fmt.format("{}<text x=\"{}\" y=\"{}\" text-anchor=\"middle\">{}</text>\n",
                    output, right, bottom + 18.0, escape_xml(fmt.format("{}", xmax)));
    output = fmt.format("{}<text x=\"{}\" y=\"{}\" text-anchor=\"end\">{}</text>\n",
                    output, left - 8.0, bottom + 4.0, escape_xml(fmt.format("{}", ymin)));
    output = fmt.format("{}<text x=\"{}\" y=\"{}\" text-anchor=\"end\">{}</text>\n",
                    output, left - 8.0, top + 4.0, escape_xml(fmt.format("{}", ymax)));
    return fmt.format("{}</g>", output);
}

fn render_labels(chart: Chart, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    output = "<g class=\"labels\" fill=\"#0f172a\" font-family=\"sans-serif\">\n";
    if chart.title_text != "" {
        output = fmt.format("{}<text x=\"{}\" y=\"28\" text-anchor=\"middle\" font-size=\"18\" font-weight=\"700\">{}</text>\n",
                        output, (chart.width to real64) / 2.0, escape_xml(chart.title_text));
    }
    if chart.x_label_text != "" {
        output = fmt.format("{}<text x=\"{}\" y=\"{}\" text-anchor=\"middle\" font-size=\"13\">{}</text>\n",
                        output, (chart.width to real64) / 2.0, (chart.height to real64) - 16.0,
                        escape_xml(chart.x_label_text));
    }
    if chart.y_label_text != "" {
        output = fmt.format("{}<text x=\"18\" y=\"{}\" text-anchor=\"middle\" font-size=\"13\" transform=\"rotate(-90 18 {})\">{}</text>\n",
                        output, (chart.height to real64) / 2.0, (chart.height to real64) / 2.0,
                        escape_xml(chart.y_label_text));
    }

    return fmt.format("{}</g>\n", output);
}

fn render_series(chart: Chart, series: Series, series_index: int, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    if series.kind == "scatter" {
        return render_scatter(chart, series, xmin, xmax, ymin, ymax);
    }
    if series.kind == "bar" {
        return render_bar(chart, series, series_index, xmin, xmax, ymin, ymax);
    }
    if series.kind == "area" {
        return render_area(chart, series, xmin, xmax, ymin, ymax);
    }
    if series.kind == "step" {
        return render_step(chart, series, xmin, xmax, ymin, ymax);
    }

    return render_line(chart, series, xmin, xmax, ymin, ymax);
}

fn render_line(chart: Chart, series: Series, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    points = "";
    for index = 0; index < series.xs.len(); index = index + 1 {
        px = scale_x(chart, series.xs[index], xmin, xmax);
        py = scale_y(chart, series.ys[index], ymin, ymax);
        pair = fmt.format("{},{}", px, py);
        if index == 0 {
            points = pair;
        } else {
            points = fmt.format("{} {}", points, pair);
        }
    }

    return fmt.format("<polyline class=\"series line\" fill=\"none\" stroke=\"{}\" stroke-width=\"2\" points=\"{}\"/>",
                  series.color, points);
}

fn render_scatter(chart: Chart, series: Series, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    output = fmt.format("<g class=\"series scatter\" fill=\"{}\">\n", series.color);
    for index = 0; index < series.xs.len(); index = index + 1 {
        px = scale_x(chart, series.xs[index], xmin, xmax);
        py = scale_y(chart, series.ys[index], ymin, ymax);
        output = fmt.format("{}<circle cx=\"{}\" cy=\"{}\" r=\"3\"/>\n", output, px, py);
    }

    return fmt.format("{}</g>", output);
}

fn render_bar(chart: Chart, series: Series, series_index: int, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    base = scale_y(chart, 0.0, ymin, ymax);
    slot_width = plot_width(chart) / (series.xs.len() to real64);

    // When several bar series share the chart, split each slot into as many
    // side-by-side sub-bars (grouped bars, like a category comparison).
    bar_count = count_bar_series(chart);
    ordinal = bar_ordinal(chart, series_index);
    group_width = slot_width * 0.7;
    sub_width = group_width / (bar_count to real64);
    // Offset this series' bar from the slot centre so the group is centred.
    offset = 0.0 - group_width / 2.0 + ((ordinal to real64) + 0.5) * sub_width;

    output = fmt.format("<g class=\"series bar\" fill=\"{}\">\n", series.color);
    for index = 0; index < series.xs.len(); index = index + 1 {
        center = scale_x(chart, series.xs[index], xmin, xmax) + offset;
        top = scale_y(chart, series.ys[index], ymin, ymax);
        y = top;
        height = base - top;
        if height < 0.0 {
            y = base;
            height = 0.0 - height;
        }

        output = fmt.format("{}<rect x=\"{}\" y=\"{}\" width=\"{}\" height=\"{}\"/>\n",
                        output, center - sub_width / 2.0, y, math.round(sub_width), height);
    }

    return fmt.format("{}</g>", output);
}

// How many bar series the chart holds (for grouping side-by-side bars).
fn count_bar_series(chart: Chart): int {
    total = 0;
    for index = 0; index < chart.series.len(); index = index + 1 {
        if chart.series[index].kind == "bar" {
            total = total + 1;
        }
    }

    return total;
}

// The position of the series at `series_index` among the chart's bar series.
fn bar_ordinal(chart: Chart, series_index: int): int {
    ordinal = 0;
    for index = 0; index < series_index; index = index + 1 {
        if chart.series[index].kind == "bar" {
            ordinal = ordinal + 1;
        }
    }

    return ordinal;
}

fn render_area(chart: Chart, series: Series, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    base = scale_y(chart, 0.0, ymin, ymax);
    first_x = scale_x(chart, series.xs[0], xmin, xmax);
    last_x = scale_x(chart, series.xs[series.xs.len() - 1], xmin, xmax);

    // Start on the baseline under the first sample, trace the curve, then drop
    // back to the baseline under the last sample so the polygon closes cleanly.
    points = fmt.format("{},{}", first_x, base);
    for index = 0; index < series.xs.len(); index = index + 1 {
        px = scale_x(chart, series.xs[index], xmin, xmax);
        py = scale_y(chart, series.ys[index], ymin, ymax);
        points = fmt.format("{} {},{}", points, px, py);
    }
    points = fmt.format("{} {},{}", points, last_x, base);

    output = fmt.format("<polygon class=\"series area\" fill=\"{}\" fill-opacity=\"0.25\" stroke=\"none\" points=\"{}\"/>\n",
                    series.color, points);
    // Draw the outline on top of the fill for a crisp edge.
    return fmt.format("{}{}", output, render_line(chart, series, xmin, xmax, ymin, ymax));
}

fn render_step(chart: Chart, series: Series, xmin: real64, xmax: real64, ymin: real64, ymax: real64): text {
    points = "";
    prev_y = scale_y(chart, series.ys[0], ymin, ymax);
    for index = 0; index < series.xs.len(); index = index + 1 {
        px = scale_x(chart, series.xs[index], xmin, xmax);
        py = scale_y(chart, series.ys[index], ymin, ymax);
        if index == 0 {
            points = fmt.format("{},{}", px, py);
        } else {
            // Horizontal to the new x at the old height, then vertical to the
            // new height — the staircase shape.
            points = fmt.format("{} {},{} {},{}", points, px, prev_y, px, py);
        }
        prev_y = py;
    }

    return fmt.format("<polyline class=\"series step\" fill=\"none\" stroke=\"{}\" stroke-width=\"2\" points=\"{}\"/>",
                  series.color, points);
}

// Render a pie chart: wedges sized by each series' single value, centred in the
// plot area. Pie charts have no axes, so this replaces the usual axes+series
// body entirely.
fn render_pie_body(chart: Chart): text {
    total = 0.0;
    for index = 0; index < chart.series.len(); index = index + 1 {
        total = total + chart.series[index].ys[0];
    }
    if total <= 0.0 {
        runtime.panic("plot: pie values must sum to a positive total");
    }

    cx = (chart.width to real64) / 2.0;
    cy = (chart.height to real64) / 2.0 + 8.0;
    radius = plot_height(chart) / 2.0;

    output = fmt.format("<title>{}</title>\n", escape_xml(chart.title_text));
    output = fmt.format("{}<rect width=\"{}\" height=\"{}\" fill=\"#ffffff\"/>\n", output, chart.width, chart.height);

    // Build the wedges and their labels separately: wedges need the white
    // separator stroke, but the labels must not inherit it (a white stroke on
    // white text is what made them look bloated and blurry).
    wedges = "";
    labels = "";
    angle = 0.0 - (math.PI / 2.0);   // start at 12 o'clock
    for index = 0; index < chart.series.len(); index = index + 1 {
        value = chart.series[index].ys[0];
        sweep = (value / total) * math.TAU;
        next_angle = angle + sweep;

        x1 = cx + radius * math.cos(angle);
        y1 = cy + radius * math.sin(angle);
        x2 = cx + radius * math.cos(next_angle);
        y2 = cy + radius * math.sin(next_angle);

        large = 0;
        if sweep > math.PI {
            large = 1;
        }

        // A single wedge: centre -> arc start -> arc end -> back to centre.
        path = fmt.format("M {} {} L {} {} A {} {} 0 {} 1 {} {} Z",
                      math.round(cx), math.round(cy), math.round(x1), math.round(y1),
                      math.round(radius), math.round(radius), large, math.round(x2), math.round(y2));
        wedges = fmt.format("{}<path fill=\"{}\" d=\"{}\"/>\n", wedges, chart.series[index].color, path);

        // Percentage label at the wedge's mid-angle, part-way out from centre.
        mid = angle + sweep / 2.0;
        lx = cx + radius * 0.62 * math.cos(mid);
        ly = cy + radius * 0.62 * math.sin(mid);
        percent = math.round((value / total) * 100.0);
        labels = fmt.format("{}<text x=\"{}\" y=\"{}\" text-anchor=\"middle\">{}%</text>\n",
                        labels, math.round(lx), math.round(ly) + 4, percent);

        angle = next_angle;
    }

    output = fmt.format("{}<g class=\"series pie\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linejoin=\"round\">\n{}</g>\n",
                    output, wedges);
    // Dark labels with a white halo (paint-order draws the stroke first) so they
    // stay crisp and readable on any wedge colour.
    output = fmt.format("{}<g class=\"pie-labels\" fill=\"#1f2937\" stroke=\"#ffffff\" stroke-width=\"3\" stroke-linejoin=\"round\" paint-order=\"stroke\" font-family=\"sans-serif\" font-size=\"13\" font-weight=\"700\">\n{}</g>\n",
                    output, labels);

    output = fmt.format("{}{}", output, render_labels(chart, 0.0, 0.0, 0.0, 0.0));
    if chart.legend_enabled {
        output = fmt.format("{}{}", output, render_legend(chart));
    }

    return output;
}

fn render_legend(chart: Chart): text {
    output = "<g class=\"legend\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#0f172a\">\n";
    row = 0;
    x = (chart.width to real64) - 168.0;
    for index = 0; index < chart.series.len(); index = index + 1 {
        series = chart.series[index];
        if series.label_text != "" {
            y = 28.0 + (row to real64) * 18.0;
            output = fmt.format("{}<rect x=\"{}\" y=\"{}\" width=\"12\" height=\"12\" fill=\"{}\"/>\n",
                            output, x, y - 10.0, series.color);
            output = fmt.format("{}<text x=\"{}\" y=\"{}\">{}</text>\n",
                            output, x + 18.0, y, escape_xml(series.label_text));
            row = row + 1;
        }
    }

    return fmt.format("{}</g>\n", output);
}
