// Generic array utilities exposed both as methods on `[T]` and as free
// functions. Most are written directly on top of indexing, `len()`, and
// `push()`; nothing here needs native support. Methods with a `<T>` are generic
// over the element type; some carry a `T is numeric` bound for arithmetic.

// A shallow copy of this array (new backing array, same elements).
export method<T> [T].copy(): [T] {
    result: [T] = [];
    // Append each element in order into the fresh array.
    for index = 0; index < this.len(); index = index + 1 {
        result.push(this[index]);
    }

    return result;
}

// A new array with the elements in reverse order.
export method<T> [T].reverse(): [T] {
    result: [T] = [];
    // Walk from the end toward the front, appending as we go.
    index = this.len();
    while index > 0 {
        index = index - 1;
        result.push(this[index]);
    }

    return result;
}

// True when `needle` appears in the array (delegates to index_of).
export method<T> [T].contains(needle: T): bool {
    return index_of(this, needle) >= 0;
}

// The index of the first element equal to `needle`, or -1 if none.
export method<T> [T].index_of(needle: T): int {
    for index = 0; index < this.len(); index = index + 1 {
        if this[index] == needle {
            return index;
        }
    }

    // -1 sentinel meaning "not found".
    return 0 - 1;
}

// The first element (indexing panics if the array is empty).
export method<T> [T].first(): T {
    return this[0];
}

// The last element (index len-1).
export method<T> [T].last(): T {
    return this[this.len() - 1];
}

// A copy of this array with `value` appended at the end.
export method<T> [T].append(value: T): [T] {
    // Copy first so the original array is left unchanged.
    result: [T] = copy(this);
    result.push(value);
    return result;
}

// A copy of this array with `value` inserted at the front.
export method<T> [T].prepend(value: T): [T] {
    // Start with the new value, then append the existing elements.
    result: [T] = [value];
    for index = 0; index < this.len(); index = index + 1 {
        result.push(this[index]);
    }

    return result;
}

// A new array made of this array followed by `other`.
export method<T> [T].concat(other: [T]): [T] {
    // Copy self, then append every element of `other`.
    result: [T] = copy(this);
    for index = 0; index < other.len(); index = index + 1 {
        result.push(other[index]);
    }

    return result;
}

// The sub-array from `start` (inclusive) to `end` (exclusive).
export method<T> [T].slice(start: int, end: int): [T] {
    result: [T] = [];
    for index = start; index < end; index = index + 1 {
        result.push(this[index]);
    }

    return result;
}

// The first `count` elements (a prefix slice).
export method<T> [T].take(count: int): [T] {
    return slice(this, 0, count);
}

// Everything after the first `count` elements (a suffix slice).
export method<T> [T].drop(count: int): [T] {
    return slice(this, count, this.len());
}

// How many elements equal `needle`.
export method<T> [T].count_value(needle: T): int {
    count = 0;
    for index = 0; index < this.len(); index = index + 1 {
        if this[index] == needle {
            count = count + 1;
        }
    }

    return count;
}

// True when this array and `other` have equal length and equal elements.
export method<T> [T].equals(other: [T]): bool {
    // Different lengths cannot be equal.
    if this.len() != other.len() {
        return false;
    }

    // Any differing element makes them unequal.
    for index = 0; index < this.len(); index = index + 1 {
        if this[index] != other[index] {
            return false;
        }
    }

    return true;
}

// Overwrite every slot with `value` in place (returns unit, mutates self).
export method<T> [T].fill(value: T): unit {
    for index = 0; index < this.len(); index = index + 1 {
        this[index] = value;
    }
}

// --- Higher-order pipelines -------------------------------------------------
// These take function values (`fn(...)`) so collection code reads as a chain:
//   values.filter(is_positive).map(square).sum();
// Each returns a fresh array (or a scalar) and never mutates the receiver.

// A new array with `transform` applied to every element.
export method<T, U> [T].map(transform: fn(T): U): [U] {
    result: [U] = [];
    for index = 0; index < this.len(); index = index + 1 {
        result.push(transform(this[index]));
    }

    return result;
}

// A new array holding only the elements for which `keep` returns true.
export method<T> [T].filter(keep: fn(T): bool): [T] {
    result: [T] = [];
    for index = 0; index < this.len(); index = index + 1 {
        if keep(this[index]) {
            result.push(this[index]);
        }
    }

    return result;
}

// Left fold: seed an accumulator with `initial`, then combine it with each
// element in order. `combine` receives (accumulator, element).
export method<T, Acc> [T].fold(initial: Acc, combine: fn(Acc, T): Acc): Acc {
    result: Acc = initial;
    for index = 0; index < this.len(); index = index + 1 {
        result = combine(result, this[index]);
    }

    return result;
}

// Reduce with the first element as the seed (panics on an empty array, since
// there is no element to start from). `combine` receives (accumulator, element).
export method<T> [T].reduce(combine: fn(T, T): T): T {
    result: T = this[0];
    for index = 1; index < this.len(); index = index + 1 {
        result = combine(result, this[index]);
    }

    return result;
}

// True when `predicate` holds for at least one element (short-circuits).
export method<T> [T].any(predicate: fn(T): bool): bool {
    for index = 0; index < this.len(); index = index + 1 {
        if predicate(this[index]) {
            return true;
        }
    }

    return false;
}

// True when `predicate` holds for every element (short-circuits on the first
// failure; vacuously true for an empty array).
export method<T> [T].all(predicate: fn(T): bool): bool {
    for index = 0; index < this.len(); index = index + 1 {
        if !predicate(this[index]) {
            return false;
        }
    }

    return true;
}

// How many elements satisfy `predicate`.
export method<T> [T].count_where(predicate: fn(T): bool): int {
    count = 0;
    for index = 0; index < this.len(); index = index + 1 {
        if predicate(this[index]) {
            count = count + 1;
        }
    }

    return count;
}

// The half-open integer range [start, end) as an array.
export fn range(start: int, end: int): [int] {
    result: [int] = [];
    for value = start; value < end; value = value + 1 {
        result.push(value);
    }

    return result;
}

// The range [0, end); an overload that defaults the start to 0.
export fn range(end: int): [int] {
    return range(0, end);
}

// The range [start, end) advancing by `step` (supports negative steps).
export fn range(start: int, end: int, step: int): [int] {
    result: [int] = [];
    // Positive step: count upward until reaching `end`.
    if step > 0 {
        value = start;
        while value < end {
            result.push(value);
            value = value + step;
        }

        return result;
    }

    // Otherwise (negative step): count downward until reaching `end`.
    value = start;
    while value > end {
        result.push(value);
        value = value + step;
    }

    return result;
}

// An array containing `value` repeated `count` times (generic element type).
export fn repeat<T>(value: T, count: int): [T] {
    result: [T] = [];
    for index = 0; index < count; index = index + 1 {
        result.push(value);
    }

    return result;
}

// `count` numeric zeros. The literal 0 takes on the requested numeric type T.
export fn zeros<T is numeric>(count: int): [T] {
    result: [T] = [];
    for index = 0; index < count; index = index + 1 {
        result.push(0);
    }

    return result;
}

// `count` numeric ones (the literal 1 takes on the numeric type T).
export fn ones<T is numeric>(count: int): [T] {
    result: [T] = [];
    for index = 0; index < count; index = index + 1 {
        result.push(1);
    }

    return result;
}

// `count` copies of `value`; a named alias for `repeat`.
export fn full<T>(count: int, value: T): [T] {
    return repeat(value, count);
}

// Sum of an int array (free-function form).
export fn sum(values: [int]): int {
    result = 0;
    for index = 0; index < values.len(); index = index + 1 {
        result = result + values[index];
    }

    return result;
}

// Sum of a numeric array as a method. `result` starts at 0 typed as T.
export method<T is numeric> [T].sum(): T {
    result: T = 0;
    for index = 0; index < this.len(); index = index + 1 {
        result = result + this[index];
    }

    return result;
}

// Product of all elements (starts from the multiplicative identity 1).
export method<T is numeric> [T].product(): T {
    result: T = 1;
    for index = 0; index < this.len(); index = index + 1 {
        result = result * this[index];
    }

    return result;
}

// The minimum element (assumes at least one element; seeds with index 0).
export method<T is numeric> [T].min(): T {
    result: T = this[0];
    for index = 1; index < this.len(); index = index + 1 {
        if this[index] < result {
            result = this[index];
        }
    }

    return result;
}

// The maximum element (seeds with the first element, then scans the rest).
export method<T is numeric> [T].max(): T {
    result: T = this[0];
    for index = 1; index < this.len(); index = index + 1 {
        if this[index] > result {
            result = this[index];
        }
    }

    return result;
}

// The index of the minimum element (argmin).
export method<T is numeric> [T].argmin(): int {
    // Track the index of the smallest value seen so far.
    result = 0;
    for index = 1; index < this.len(); index = index + 1 {
        if this[index] < this[result] {
            result = index;
        }
    }

    return result;
}

// The index of the maximum element (argmax).
export method<T is numeric> [T].argmax(): int {
    // Track the index of the largest value seen so far.
    result = 0;
    for index = 1; index < this.len(); index = index + 1 {
        if this[index] > this[result] {
            result = index;
        }
    }

    return result;
}

// True when every element of a bool array is true (logical AND-reduce).
export method [bool].all(): bool {
    for index = 0; index < this.len(); index = index + 1 {
        // A single false short-circuits the whole result.
        if !this[index] {
            return false;
        }
    }

    return true;
}

// True when any element of a bool array is true (logical OR-reduce).
export method [bool].any(): bool {
    for index = 0; index < this.len(); index = index + 1 {
        // A single true short-circuits the whole result.
        if this[index] {
            return true;
        }
    }

    return false;
}

// Sum of a real64 array (free-function overload; result seeded as 0.0).
export fn sum(values: [real64]): real64 {
    result: real64 = 0.0;
    for index = 0; index < values.len(); index = index + 1 {
        result = result + values[index];
    }

    return result;
}
