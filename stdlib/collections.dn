// Small convenience constructors for building short arrays of ints and text.
// These are handy shorthands so callers do not have to write array literals
// by hand for the most common one- and two-element cases.

// A one-element int array holding `value`.
export fn singleton_int(value: int): [int] {
    return [value];
}

// A two-element int array holding `left` then `right`.
export fn pair_int(left: int, right: int): [int] {
    return [left, right];
}

// A one-element text array holding `value`.
export fn singleton_text(value: text): [text] {
    return [value];
}

// A two-element text array holding `left` then `right`.
export fn pair_text(left: text, right: text): [text] {
    return [left, right];
}

// Build an int array that repeats `value` exactly `count` times.
export fn repeat_int(value: int, count: int): [int] {
    // Start from an empty array and grow it one element at a time.
    values: [int] = [];
    // Loop `count` times, appending `value` on each iteration.
    for index = 0; index < count; index = index + 1 {
        values.push(value);
    }

    // Return the fully populated array.
    return values;
}
