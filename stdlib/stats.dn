// Descriptive statistics over all matrix elements in row-major order.
export fn describe<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<Summary, text> {
    return describe(values.to_array());
}

// Histogram over all matrix elements in row-major order.
export fn histogram<T is numeric>(values: matrix.Matrix<T>, bins: int): outcome.Outcome<Histogram, text> {
    return histogram(values.to_array(), bins);
}

// One comprehensive Summary per matrix column. Rows are observations and
// columns are variables, matching NumPy/SciPy's conventional data layout.
export fn describe_columns<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<[Summary], text> {
    empty: [Summary] = [];
    if values.cols() == 0 {
        return outcome.failed(empty, "stats.describe_columns: matrix must have at least one column");
    }
    if values.rows() < 2 {
        return outcome.failed(empty, "stats.describe_columns: matrix must have at least two rows");
    }
    result: [Summary] = [];
    for col = 0; col < values.cols(); col = col + 1 {
        result.push(describe(values.column(col))?);
    }
    return outcome.done(result, "");
}

// One comprehensive Summary per matrix row.
export fn describe_rows<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<[Summary], text> {
    empty: [Summary] = [];
    if values.rows() == 0 {
        return outcome.failed(empty, "stats.describe_rows: matrix must have at least one row");
    }
    if values.cols() < 2 {
        return outcome.failed(empty, "stats.describe_rows: matrix must have at least two columns");
    }
    result: [Summary] = [];
    for row = 0; row < values.rows(); row = row + 1 {
        result.push(describe(values.row(row))?);
    }
    return outcome.done(result, "");
}

// Column means as a Vector. Empty matrix axes return Failed, not a VM panic.
export fn column_means<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Vector<real64>, text> {
    if values.cols() == 0 || values.rows() == 0 {
        return outcome.failed(empty_vector(), "stats.column_means: matrix axes must be non-empty");
    }
    result: [real64] = [];
    for col = 0; col < values.cols(); col = col + 1 {
        result.push(mean(values.column(col))?);
    }
    return outcome.done(matrix.vector(result), "");
}

// Row means as a Vector.
export fn row_means<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Vector<real64>, text> {
    if values.cols() == 0 || values.rows() == 0 {
        return outcome.failed(empty_vector(), "stats.row_means: matrix axes must be non-empty");
    }
    result: [real64] = [];
    for row = 0; row < values.rows(); row = row + 1 {
        result.push(mean(values.row(row))?);
    }
    return outcome.done(matrix.vector(result), "");
}

// Sample variance of each matrix column.
export fn column_variances<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Vector<real64>, text> {
    if values.cols() == 0 || values.rows() < 2 {
        return outcome.failed(empty_vector(), "stats.column_variances: expected at least two rows and one column");
    }
    result: [real64] = [];
    for col = 0; col < values.cols(); col = col + 1 {
        result.push(variance(values.column(col))?);
    }
    return outcome.done(matrix.vector(result), "");
}

// Sample standard deviation of each matrix column.
export fn column_stddevs<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Vector<real64>, text> {
    variances: matrix.Vector<real64> = column_variances(values)?;
    result: [real64] = [];
    for index = 0; index < variances.len(); index = index + 1 {
        result.push(math.sqrt(variances.get(index)));
    }
    return outcome.done(matrix.vector(result), "");
}

// Median of each matrix column.
export fn column_medians<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Vector<real64>, text> {
    if values.cols() == 0 || values.rows() == 0 {
        return outcome.failed(empty_vector(), "stats.column_medians: matrix axes must be non-empty");
    }
    result: [real64] = [];
    for col = 0; col < values.cols(); col = col + 1 {
        result.push(median(values.column(col))?);
    }
    return outcome.done(matrix.vector(result), "");
}

// One histogram per matrix column, useful immediately after csv.read_matrix.
export fn column_histograms<T is numeric>(values: matrix.Matrix<T>, bins: int): outcome.Outcome<[Histogram], text> {
    empty: [Histogram] = [];
    if values.cols() == 0 || values.rows() == 0 {
        return outcome.failed(empty, "stats.column_histograms: matrix axes must be non-empty");
    }
    if bins <= 0 {
        return outcome.failed(empty, "stats.column_histograms: bin count must be positive");
    }
    result: [Histogram] = [];
    for col = 0; col < values.cols(); col = col + 1 {
        result.push(histogram(values.column(col), bins)?);
    }
    return outcome.done(result, "");
}

// Sample covariance matrix. Rows are observations, columns are variables.
export fn covariance_matrix<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Matrix<real64>, text> {
    if values.rows() < 2 || values.cols() == 0 {
        return outcome.failed(empty_matrix(), "stats.covariance_matrix: expected at least two rows and one column");
    }
    rows: [[real64]] = [];
    for left = 0; left < values.cols(); left = left + 1 {
        row: [real64] = [];
        for right = 0; right < values.cols(); right = right + 1 {
            row.push(covariance(values.column(left), values.column(right))?);
        }
        rows.push(row);
    }
    return outcome.done(matrix.from_rows(rows), "");
}

// Pearson correlation matrix. Any constant column yields a clear Failed value.
export fn correlation_matrix<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Matrix<real64>, text> {
    if values.rows() < 2 || values.cols() == 0 {
        return outcome.failed(empty_matrix(), "stats.correlation_matrix: expected at least two rows and one column");
    }
    rows: [[real64]] = [];
    for left = 0; left < values.cols(); left = left + 1 {
        row: [real64] = [];
        for right = 0; right < values.cols(); right = right + 1 {
            row.push(correlation(values.column(left), values.column(right))?);
        }
        rows.push(row);
    }
    return outcome.done(matrix.from_rows(rows), "");
}

// Standardize every matrix column to sample mean 0 and sample standard
// deviation 1. Constant columns are rejected explicitly.
export fn standardize_columns<T is numeric>(values: matrix.Matrix<T>): outcome.Outcome<matrix.Matrix<real64>, text> {
    centers: matrix.Vector<real64> = column_means(values)?;
    scales: matrix.Vector<real64> = column_stddevs(values)?;
    for col = 0; col < scales.len(); col = col + 1 {
        if scales.get(col) == 0.0 {
            return outcome.failed(empty_matrix(), "stats.standardize_columns: every column must vary");
        }
    }
    flattened: [real64] = [];
    for row = 0; row < values.rows(); row = row + 1 {
        for col = 0; col < values.cols(); col = col + 1 {
            standardized = ((values.get(row, col) to real64) - centers.get(col)) / scales.get(col);
            flattened.push(standardized);
        }
    }
    result = matrix.Matrix.new(values.rows(), values.cols(), flattened);
    return outcome.done(result, "");
}

// Fit y on x using two columns from one observation matrix. This is convenient
// for matrices loaded by the csv module.
export fn linear_regression_columns<T is numeric>(values: matrix.Matrix<T>, x_column: int, y_column: int): outcome.Outcome<LinearRegression, text> {
    if x_column < 0 || x_column >= values.cols() || y_column < 0 || y_column >= values.cols() {
        return outcome.failed(empty_regression(), "stats.linear_regression_columns: column index out of range");
    }
    return linear_regression(values.column(x_column), values.column(y_column));
}
