import io;
// Showcases every comment form Dune understands and how documentation comments
// attach to declarations. Hover any documented name in an editor with the Dune
// LSP to see its doc-comment rendered next to the signature.

/// brief: Squares a value.
/// param value: the number to multiply by itself
/// returns: value * value
fn square(value: int): int {
    return value * value;
}

/* A block comment can span
   several lines and is skipped like whitespace. */

/** brief: A point on the integer grid.
  * Fields and methods can each carry their own documentation. */
record Point {
    // The horizontal coordinate.
    x: int,
    // The vertical coordinate.
    y: int,

    /// brief: The squared distance from the origin.
    /// returns: x*x + y*y
    fn magnitude_squared(): int {
        return square(this.x) + square(this.y);
    }
}

p: Point = Point { x: 3, y: 4 };

// `square` is documented above; hover it to read the brief/param/returns tags.
io.println(square(p.x));            // 9

// Hover `x` or `magnitude_squared` to see the record member documentation.
io.println(p.magnitude_squared());  // 25
