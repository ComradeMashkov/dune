import io;
// Collection pipelines: first-class function values let data-processing code read
// as a fluent chain of `.filter(...).map(...).reduce(...)` steps instead of a
// stack of manual loops and temporaries. Named functions are passed by name as
// function values; each stdlib method returns a fresh array (or a scalar), so
// the steps compose left to right.
import array;

// --- Callbacks: plain named functions used as `fn(...)` values --------------

// Transform: square a number.
fn square(x: int): int { return x * x; }
// Predicate: keep strictly positive numbers.
fn is_positive(x: int): bool { return x > 0; }
// Predicate: keep even numbers.
fn is_even(x: int): bool { return x % 2 == 0; }
// Reducer: sum an accumulator with the next element.
fn add(acc: int, x: int): int { return acc + x; }

// A sample data set mixing negative and positive values.
readings = [0 - 4, 3, 0 - 1, 6, 5, 0 - 2, 8];

// --- A multi-line pipeline --------------------------------------------------
// Keep the positive readings, square them, and sum the squares. Written across
// several lines to show that a method chain can span newlines.
positives_energy = readings
    .filter(is_positive)
    .map(square)
    .fold(0, add);
// 3^2 + 6^2 + 5^2 + 8^2 = 9 + 36 + 25 + 64 = 134.
io.println(positives_energy);

// --- Predicate reductions ---------------------------------------------------
// Does any reading exceed zero? (true -> 1)
io.println(readings.any(is_positive));
// Are all readings positive? (false -> 0)
io.println(readings.all(is_positive));
// How many readings are even? (-4, 6, -2, 8 -> 4)
io.println(readings.count_where(is_even));

// --- Building and transforming a range --------------------------------------
// range(1, 8) is [1..7]; square each, keep the even squares, and sum them.
even_square_total = array.range(1, 8)
    .map(square)
    .filter(is_even)
    .fold(0, add);
// squares 1,4,9,16,25,36,49 -> evens 4,16,36 -> 56.
io.println(even_square_total);

// --- Mapping to a different element type ------------------------------------
// map(int -> bool) produces a mask; count how many entries are even.
mask = array.range(1, 11).map(is_even);
// 2,4,6,8,10 -> 5 even numbers in 1..10.
io.println(mask.count_value(true));
