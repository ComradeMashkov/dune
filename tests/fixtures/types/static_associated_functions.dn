import io;
// Record demonstrating static associated functions (constructors called on the type).
record Optimizer {
    // Learning-rate field.
    lr: real64,
    // Momentum field.
    momentum: real64,

    // Exported static associated function: Optimizer.default(), no `this`, returns a preset instance.
    export static fn default(): Optimizer {
        return Optimizer { lr: 0.01, momentum: 0.0 };
    }

    // Exported static associated function taking a parameter, building an Optimizer with given lr.
    export static fn with_lr(lr: real64): Optimizer {
        return Optimizer { lr: lr, momentum: 0.0 };
    }

    // Instance method (has `this`) returning the lr field.
    fn rate(): real64 {
        return this.lr;
    }
}

// Generic record Box<T> with a static associated function.
record Box<T> {
    // Generic field of type T.
    value: T,

    // Exported static associated function wrapping a value into Box<T>.
    export static fn wrap(value: T): Box<T> {
        return Box { value: value };
    }

    // Instance method returning the stored T via `this`.
    fn get(): T {
        return this.value;
    }
}

// Call the static default() on the type to build an Optimizer.
opt: Optimizer = Optimizer.default();
// Read lr through the instance method rate().
io.println(opt.rate());

// Call the parameterized static with_lr() to build another Optimizer.
tuned: Optimizer = Optimizer.with_lr(0.2);
// Read the tuned lr.
io.println(tuned.rate());

// Call the generic static wrap(), instantiating Box<int>.
boxed: Box<int> = Box.wrap(42);
// Retrieve the boxed value via get().
io.println(boxed.get());
