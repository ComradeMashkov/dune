import io;
// Function returning unit (no value): prints then explicitly returns.
fn say(message: text): unit {
    // Print the text argument.
    io.println(message);
    // Bare return from a unit function.
    return;
}

// Unit function with an empty body: implicitly returns unit.
fn noop(): unit {
}

// Function over i32 (signed 32-bit int), returning its successor.
fn next(value: i32): i32 {
    return value + 1;
}

// i8: signed 8-bit integer.
tiny: i8 = 12;
// i16: signed 16-bit integer.
small: i16 = 32000;
// i32 produced by calling next(40) -> 41.
mid: i32 = next(40);
// i64: signed 64-bit integer holding a large value.
wide: i64 = 9000000000;
// usize: pointer-sized unsigned integer.
count: usize = 5;
// isize: pointer-sized signed integer.
offset: isize = 6;
// real32: 32-bit float.
sample: real32 = 1.5;
// real32 arithmetic: adds a 32-bit float literal.
sample_sum: real32 = sample + 2.25;
// real64: 64-bit float.
precise: real64 = 2.25;
// text: string value.
status: text = "same";

// Call the unit function with a text literal.
say("types");
// Call the empty unit function.
noop();
// Print the i8 value.
io.println(tiny);
// Print the i16 value.
io.println(small);
// Print the i32 value.
io.println(mid);
// Print the i64 value.
io.println(wide);
// Print the usize value.
io.println(count);
// Print the isize value.
io.println(offset);
// Print the real32 sum.
io.println(sample_sum);
// Print the real64 value.
io.println(precise);
// Branch on text equality using ==.
if status == "same" {
    // Taken branch: status equals "same".
    io.println(status);
} else {
    // Untaken branch for the non-matching case.
    io.println("bad");
}
