// Exercises `foreknown` compile-time constants and functions.
// Foreknown functions run entirely at compile time; the constants they
// produce are folded into the bytecode before the program starts.
import io;

foreknown const KB: int = 1024;

foreknown fn scale(n: int): int {
    return n * KB;
}

foreknown fn factorial(n: int): int {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

foreknown fn sum_to(n: int): int {
    total: int = 0;
    for i: int = 0; i <= n; i = i + 1 {
        total = total + i;
    }
    return total;
}

foreknown const PAGE: int = scale(4);
foreknown const FACT5: int = factorial(5);
foreknown const TRIANGLE: int = sum_to(10);

io.println(KB);       // 1024
io.println(PAGE);     // 4096
io.println(FACT5);    // 120
io.println(TRIANGLE); // 55
