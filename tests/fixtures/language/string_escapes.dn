import io;
// Raw string literal (r"..."): backslashes are literal, not escape sequences.
path: text = r"C:\Users\name\data.csv";
// Prints the raw path with backslashes intact.
io.println(path);
// \n escape produces a newline, splitting output across "hello" and "world".
io.println("hello\nworld");
// \" escapes embed literal double-quote characters -> quote "ok".
io.println("quote \"ok\"");
// \\ escapes a single literal backslash -> slash \ ok.
io.println("slash \\ ok");
// glyph literal '\n' cast to its int code point -> 10 (newline).
io.println('\n' to int);
// glyph literal '\t' cast to int -> 9 (tab).
io.println('\t' to int);
// glyph literal '\r' cast to int -> 13 (carriage return).
io.println('\r' to int);
// glyph literal for a single backslash character.
io.println('\\');
// glyph literal for a single-quote character.
io.println('\'');
// glyph literal '\0' (null) cast to int -> 0.
io.println('\0' to int);
