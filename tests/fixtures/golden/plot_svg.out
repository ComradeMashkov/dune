<text x="64" y="354" text-anchor="middle">0.5</text>
<text x="604" y="354" text-anchor="middle">3.5</text>
<text x="56" y="340" text-anchor="end">0</text>
<text x="56" y="52" text-anchor="end">8</text>
</g>
<polyline class="series line" fill="none" stroke="#2563eb" stroke-width="2" points="154,264 334,192 514,48"/>
<g class="series scatter" fill="#dc2626">
<circle cx="154" cy="282" r="3"/>
<circle cx="334" cy="228" r="3"/>
<circle cx="514" cy="84" r="3"/>
</g>
<g class="series bar" fill="#16a34a">
<rect x="91" y="300" width="126" height="36"/>
