<rect x="451" y="228" width="126" height="108"/>
</g>
<g class="labels" fill="#0f172a" font-family="sans-serif">
<text x="320" y="28" text-anchor="middle" font-size="18" font-weight="700">growth &lt;&amp;&gt;</text>
<text x="320" y="384" text-anchor="middle" font-size="13">x axis</text>
<text x="18" y="200" text-anchor="middle" font-size="13" transform="rotate(-90 18 200)">value &quot;y&quot;</text>
</g>
<g class="legend" font-family="sans-serif" font-size="12" fill="#0f172a">
