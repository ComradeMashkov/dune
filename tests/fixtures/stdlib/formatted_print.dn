import io;
import fmt;
// Exercises formatted printing: print with {} placeholders and the format builtin.
name: text = "Dune";        // text (string) value
version: int = 1;           // int value
mark: glyph = 'Z';          // glyph (single character) value
ratio: real64 = 2.5;        // real64 value

// print with placeholders: each {} consumes the next argument.
io.println(fmt.format("{} v{}", name, version));
// format: build a text value from a template instead of printing directly.
message: text = fmt.format("{} v{} {}", name, version, mark);
io.println(message);             // print the pre-formatted text
io.println(fmt.format("inline {}", 42));  // format an int inline, then print
// Mixed types (bool, glyph, real) all fill {} placeholders.
io.println(fmt.format("bool={}, glyph={}, real={}", true, mark, ratio));
io.println("plain text still works");  // print with no placeholders
io.println(42);                        // print a bare int
