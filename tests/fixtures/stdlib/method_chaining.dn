import io;
// Exercises first-class function values and the higher-order array pipeline:
// map / filter / fold / reduce / any / all / count_where, chained fluently.
import array;

// Named functions used as callbacks (passed by name as function values).
fn square(x: int): int { return x * x; }
fn is_positive(x: int): bool { return x > 0; }
fn is_even(x: int): bool { return x % 2 == 0; }
fn add(acc: int, x: int): int { return acc + x; }
fn max_of(acc: int, x: int): int {
    // Keep the larger of the running accumulator and the current element.
    if x > acc { return x; }
    return acc;
}

values = [0 - 3, 2, 0 - 1, 4, 5];

// The acceptance-criteria chain, written across multiple lines to prove that
// newlines inside a method chain parse correctly.
result = values
    .filter(is_positive)
    .map(square)
    .sum();
io.println(result);                         // 2^2 + 4^2 + 5^2 = 45

// map to a different element type (int -> bool) then count the trues.
io.println([1, 2, 3, 4].map(is_even).count_value(true));  // 2 and 4 -> 2

// filter then count the survivors.
io.println(values.filter(is_positive).len());             // 2, 4, 5 -> 3

// fold with an explicit seed and reduce seeded by the first element.
io.println(values.fold(0, add));            // -3+2-1+4+5 -> 7
io.println(values.reduce(max_of));          // running max -> 5
io.println([10, 20, 30].reduce(add));       // 60

// predicate any / all / count_where.
io.println(values.any(is_positive));        // true -> 1
io.println(values.all(is_positive));        // false -> 0
io.println(values.count_where(is_even));    // 2 and 4 -> 2

// A chain that mixes higher-order and structural array methods.
io.println(array.range(1, 6)
    .map(square)
    .filter(is_even)
    .sum());                           // 1,4,9,16,25 -> evens 4,16 -> 20
