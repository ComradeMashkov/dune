// Exercises Modules v2: an optional `module` declaration, an aliased import, and
// selective / grouped `from ... import` for both a local module and the stdlib.
module modules_v2;

// Alias a whole module: `sh.Name` refers to shapes.Name.
import shapes as sh;
// Selective + grouped import of local symbols (a record and two functions).
from shapes import Point, manhattan, quadrant_sum;
// Selective + grouped import from the standard library.
from array import range, sum;
// Alias the stdlib math module.
import math as m;

// Construct the selectively imported record unqualified.
a = Point { x: 1, y: 2 };
// Construct via the alias-qualified record literal.
b = sh.Point { x: 4, y: 6 };

print(manhattan(a, b));          // selective fn: |1-4| + |2-6| = 7
print(sh.manhattan(a, b));       // alias-qualified fn: 7
print(quadrant_sum(b));          // selective fn: 4 + 6 = 10
print(sh.ORIGIN_SUM);            // alias-qualified constant -> 0

// Selective stdlib functions used unqualified.
r = range(1, 5);                 // [1, 2, 3, 4]
print(sum(r));                   // 1 + 2 + 3 + 4 = 10

// Aliased stdlib constant.
print(m.PI > 3);                 // true -> 1
